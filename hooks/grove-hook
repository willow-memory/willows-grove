#!/usr/bin/env bash
# b17: GRVHK  ΔΣ=42
# Grove Desk hooks — same behavior for Cursor, Claude Code, and any CLI that
# invokes:  hooks/grove-hook <cursor|claude> <action>
#
# Neutral table: hooks/client-hooks.json. Dialect names may differ; the event
# set and actions must not (gap 651b4a1ccfab). Python body: hooks/grove_hook.py.
set -euo pipefail

FMT="${1:?usage: grove-hook <cursor|claude> <action>}"
ACTION="${2:?usage: grove-hook <cursor|claude> <action>}"

SELF="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SELF_ROOT="$(cd -- "$(dirname -- "$SELF")/.." && pwd -P)"
ROOT="${WILLOW_PROJECT_ROOT:-${CLAUDE_PROJECT_DIR:-$SELF_ROOT}}"
cd "$ROOT"

PY="${WILLOW_MCP_PYTHON:-}"
if [[ -z "${PY}" || ! -x "${PY}" ]]; then
  for candidate in \
    "${WILLOW_HOME:+$WILLOW_HOME/venvs/willow-mcp/bin/python}" \
    "$ROOT/.venv/bin/python" \
    "$ROOT/.venv/bin/python3"
  do
    if [[ -n "${candidate}" && -x "${candidate}" ]]; then
      PY="${candidate}"
      break
    fi
  done
fi
if [[ -z "${PY}" || ! -x "${PY}" ]]; then
  PY="$(command -v python3 || true)"
fi
if [[ -z "${PY}" ]]; then
  echo "grove-hook: no python interpreter found" >&2
  exit 0
fi

export WILLOW_MCP_PYTHON="${WILLOW_MCP_PYTHON:-$PY}"
exec "$PY" "$SELF_ROOT/hooks/grove_hook.py" "$FMT" "$ACTION"
