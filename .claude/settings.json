{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WILLOW_APP_ID=willow WILLOW_HUMAN_ORCHESTRATOR=1 WILLOW_KEYRING=/home/sean-campbell/sean-data-vault/willow-operator-box/config/verifiers.json WILLOW_OPERATOR_VERIFIER=sean WILLOW_HANDOFF_PROJECT=willows-grove \"$CLAUDE_PROJECT_DIR/.venv/bin/python3\" -m willow_mcp.session_start_hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|task_submit|Write|Edit|MultiEdit|NotebookEdit|WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/bin/python3\" -m willow_mcp.pre_tool_hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WILLOW_APP_ID=willow WILLOW_HUMAN_ORCHESTRATOR=1 WILLOW_KEYRING=/home/sean-campbell/sean-data-vault/willow-operator-box/config/verifiers.json WILLOW_OPERATOR_VERIFIER=sean WILLOW_HANDOFF_PROJECT=willows-grove \"$CLAUDE_PROJECT_DIR/.venv/bin/python3\" -m willow_mcp.session_stop_hook"
          }
        ]
      }
    ]
  }
}
