# Playwright e2e (INVARIANTS §10) — installed deps and per-run output.
# `npm install` / `npx playwright test` produce these locally and in CI;
# none of it is tracked-code.
node_modules/
package-lock.json
test-results/
playwright-report/

# Nestor session store — the live SQLite and its ledger are built locally from
# nestor/session-decisions.json (`nestor import --apply`), never committed.
# LOCAL-ONLY.md's rule: the blueprint travels, the live store does not. A JSON
# bundle is also reviewable in a diff; a SQLite file is not.
nestor/*.db
nestor/*.db-shm
nestor/*.db-wal
nestor/*.ledger.jsonl
