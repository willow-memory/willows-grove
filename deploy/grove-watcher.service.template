# systemd --user unit template for the Grove resident watcher (Gate 5 v1).
#
# Not used directly — fill in the @PLACEHOLDERS@ before installing, e.g.:
#
#   sed -e "s#@WORKDIR@#$(pwd)#g" \
#       -e "s#@VENV_DIR@#$(pwd)/.venv#g" \
#       -e "s#@OLLAMA_URL@#http://localhost:11434#g" \
#       deploy/grove-watcher.service.template \
#       > ~/.config/systemd/user/grove-watcher.service
#   systemctl --user daemon-reload
#   systemctl --user start grove-watcher
#
# No absolute path is baked into this template itself — @WORKDIR@ and
# @VENV_DIR@ resolve at install time from the operator's actual checkout and
# venv, so a later move of $WILLOW_HOME or the SOIL store root does not
# strand the unit. WILLOW_DB_URL is deliberately left unset here — set it
# via a drop-in (systemctl --user edit grove-watcher) if LISTEN/NOTIFY on
# Postgres is wanted; unset, the watcher runs heartbeat-only (D7).
[Unit]
Description=Willow's Grove resident watcher (Gate 5 v1, L1-capped)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@WORKDIR@
Environment=GROVE_VENV=@VENV_DIR@
Environment=GROVE_WATCHER_OLLAMA=@OLLAMA_URL@
ExecStart=@WORKDIR@/scripts/grove-watcher-run
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
