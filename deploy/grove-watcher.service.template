# systemd --user unit template for Willow's Grove resident watcher (Gate 5 v1).
# b17: WGRV1 · ΔΣ=42
#
# Parallel in shape to deploy/grove-serve.service.template and
# deploy/grove-mcp-serve.service.template. Stands up the L1-capped resident
# watcher (grove/resident_watcher.py) as a background process on this seat.
#
# The watcher is a SEPARATE process from grove_serve.py and grove.mcp_local
# --serve — different responsibility, no port. It reads LISTEN/NOTIFY on
# grove.messages and writes to kb_journal only, sender="resident-watcher"
# (never speaks as Willow or as a persona; L1 ceiling per
# docs/design/autonomous-continuity.md §5).
#
# Not used directly — resolve the @PLACEHOLDERS@ (envsubst / sed) and write the
# result to ~/.config/systemd/user/grove-watcher.service, then
# `systemctl --user daemon-reload && systemctl --user enable --now grove-watcher`.
#
# Overrides via `systemctl --user edit grove-watcher`:
#   [Service]
#   Environment=WILLOW_DB_URL=postgresql://...
#   Environment=GROVE_WATCHER_HEARTBEAT=60
[Unit]
Description=Willow's Grove resident watcher (Gate 5 v1, L1-capped)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@WORKDIR@
Environment=GROVE_VENV=@VENV_DIR@
Environment=WILLOW_HUMAN_ORCHESTRATOR=1
ExecStart=@WORKDIR@/scripts/grove-watcher-run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
