        <mxCell id="org_hk" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;hornbook-knowledge&lt;/b&gt; — &lt;i&gt;what is known&lt;/i&gt;  (4)&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;Jeles&lt;/font&gt; verified-nugget corpus, federated server&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;UTETY&lt;/font&gt; the faculty · &lt;font color=&quot;#2e7d32&quot;&gt;oakenscrolls-office&lt;/font&gt;&lt;br&gt;dotgithub&lt;br&gt;&lt;i&gt;knowledge and the personas that carry it&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="400" x="930" y="320" as="geometry" />
        </mxCell>
        <mxCell id="org_ha" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;homestead-affairs&lt;/b&gt; — &lt;i&gt;the household&lt;/i&gt;  (6)&lt;br&gt;&lt;font color=&quot;#1565c0&quot;&gt;homestead&lt;/font&gt; · &lt;font color=&quot;#1565c0&quot;&gt;-law&lt;/font&gt; · &lt;font color=&quot;#1565c0&quot;&gt;-health&lt;/font&gt; · &lt;font color=&quot;#1565c0&quot;&gt;-ledger&lt;/font&gt;&lt;br&gt;awesome-sovereign-software · dotgithub&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ embedded SQLite · I-26 no network module imports&lt;/font&gt;&lt;br&gt;&lt;i&gt;the grandma side: no egress to grant, by construction&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="440" x="1360" y="320" as="geometry" />
        </mxCell>
        <mxCell id="org_alm" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;almanac-data&lt;/b&gt; — &lt;i&gt;public reference&lt;/i&gt;  (14)&lt;br&gt;agriculture · civic · climate · economy · education · energy&lt;br&gt;environment · health · justice · science · transportation&lt;br&gt;+ almanac-template · almanac-data · dotgithub&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ held-not-fetched (H-5) — public data, names nobody&lt;/font&gt;" vertex="1">
