        </mxCell>
        <mxCell id="org_ws" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;workshop&lt;/b&gt; — &lt;i&gt;tools we did not write&lt;/i&gt;  (4)&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;codebase-memory-mcp&lt;/font&gt; — one of two MCPs NOT behind the hub&lt;br&gt;courtlistener-mcp · redential-cli · DispatchesFromReality&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ 48 of 51 cbm indexes point at trees that are gone&lt;/font&gt;" vertex="1">
