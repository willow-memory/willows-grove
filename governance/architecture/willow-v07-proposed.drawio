        <mxCell id="a7" edge="1" parent="1" source="ws_claude" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#c62828;fontColor=#c62828;fontSize=11;" target="org_dns" value="the why lives here, unread">
