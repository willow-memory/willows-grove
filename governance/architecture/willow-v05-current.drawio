        <mxCell id="dataplane" value="&lt;b&gt;THE DATA PLANE — where it actually lives today&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="500" height="20" as="geometry" /></mxCell>

        <mxCell id="pg20" value="&lt;b&gt;Postgres · willow_20&lt;/b&gt;  254 MB  &lt;font color=&quot;#2e7d32&quot;&gt;SYSTEM LANE&lt;/font&gt;&lt;br&gt;knowledge 21,914 · frank_ledger 1,206 · tasks 827&lt;br&gt;attestations 75 · session_messages 11,372 · edges 9,699&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ 8 databases culled to 2 (2026-08-28)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="400" height="110" as="geometry" /></mxCell>

        <mxCell id="pgpersonal" value="&lt;b&gt;Postgres · willow_personal&lt;/b&gt;  9 MB  &lt;font color=&quot;#1565c0&quot;&gt;PERSONAL LANE&lt;/font&gt;&lt;br&gt;74 atoms · 122 edges · 10 ratified by sean&lt;br&gt;profiles · family-adjacent · 29 atoms of lore&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ NEW — separable: pg_dump, encrypt, or delete whole&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="470" y="790" width="400" height="110" as="geometry" /></mxCell>

        <mxCell id="soil" value="&lt;b&gt;SOIL + config · $WILLOW_HOME&lt;/b&gt;&lt;br&gt;~/github/willow-memory/.willow  ←  ~/.willow (symlink)&lt;br&gt;22 collections · vault.db (0 secrets) · vault.key · dispatch_signing.key&lt;br&gt;env · fleet.env · 11 manifests · _federation registry&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ v0.4 said 402 collections — now 22; count needs resolving&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="900" y="790" width="470" height="110" as="geometry" /></mxCell>

        <mxCell id="nestorstore" value="&lt;b&gt;Nestor store&lt;/b&gt;&lt;br&gt;~/github/Die-Namic-Systems/.nestor  ←  ~/.nestor (symlink)&lt;br&gt;keep/nestor.db 23 MB · ledger.jsonl · verifiers.json&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ canonical path under the org folder (layout doctrine)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1400" y="790" width="470" height="110" as="geometry" /></mxCell>

        <mxCell id="vault" value="&lt;b&gt;(USER)-data-vault — STILL THE TARGET&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ NOT BUILT — v0.4 said this on 2026-07-20 and it is still true&lt;/font&gt;&lt;br&gt;&lt;b&gt;Postgres and SOIL are supposed to live in here.&lt;/b&gt; They do not.&lt;br&gt;&lt;br&gt;What ~/sean-data-vault holds today: &lt;font color=&quot;#2e7d32&quot;&gt;snapshots only&lt;/font&gt;&lt;br&gt;· 290 MB Postgres dumps (2026-08-28) · 2 archive tarballs · older archive layers&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ PULL-ONLY as of 2026-08-28 — push URL unresolvable by design&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ 0 secrets (gitignore blocks *.key) · Kart has NO bind to it&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;⚠ if the store moves before that bind exists: empty store, every gate passes&lt;/font&gt;&lt;br&gt;&lt;i&gt;(USER) is deliberate — another operator's target is their own user-data-vault&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="830" height="180" as="geometry" /></mxCell>

        <mxCell id="safe" value="&lt;b&gt;SAFE app store&lt;/b&gt; — &lt;font color=&quot;#1565c0&quot;&gt;the layer furthest from v0.4&lt;/font&gt;&lt;br&gt;&lt;b&gt;43 apps&lt;/b&gt; under safe-app-store-public/apps/&lt;br&gt;ai-game-master · the-table · law-gazelle · story-timeline · oakenscrolls-office&lt;br&gt;marching-arts · homestead-health · the-forge · utety-chat · +34&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ ask-jeles still a directory — the work moved to the Jeles repo&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ v0.4 drew Ask Jeles as THE product; it is now a federated server&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ this whole layer wants redrawing, not annotating&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1565c0;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="900" y="940" width="620" height="180" as="geometry" /></mxCell>

        <mxCell id="homestead" value="&lt;b&gt;Homestead — the household side&lt;/b&gt;&lt;br&gt;homestead · -law · -health · -ledger&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ embedded SQLite, I-26 verifies NO network module imports&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ I-21 nothing before a human asks · I-31 counts only&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ I-12 a window's rung is the MAX of everything in it&lt;/font&gt;&lt;br&gt;&lt;i&gt;threat model: a second person walking into the room (F-1)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1550" y="940" width="410" height="180" as="geometry" /></mxCell>

        <mxCell id="daemons" value="&lt;b&gt;Daemons / watchmen&lt;/b&gt; — &lt;font color=&quot;#c62828&quot;&gt;ONE running&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ willow-mcp-worker-fast&lt;/font&gt; · &lt;font color=&quot;#c62828&quot;&gt;✗ kart-worker · kart-worker-batch · gitsync · grove · discord — inactive&lt;/font&gt;&lt;br&gt;v0.4 showed gitsync 25min ✓ · kart workers ✓ · grove ✓ · discord ✓" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="830" height="70" as="geometry" /></mxCell>

        <mxCell id="open" value="&lt;b&gt;Open, as of 2026-08-29&lt;/b&gt;&lt;br&gt;1. Postgres + SOIL into the user data vault — the v0.4 target, still ✗&lt;br&gt;2. Kart bind for the vault — must land BEFORE the store moves&lt;br&gt;3. Declare WILLOW_LANE, then wire refusal() into knowledge_search&lt;br&gt;4. Jeles fan-out is not shaped for prose questions (starves 3 working builds)&lt;br&gt;5. Orientation payload — 4 logged gaps converge on it; jeles' is empty by construction" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="900" y="1150" width="1060" height="120" as="geometry" /></mxCell>

