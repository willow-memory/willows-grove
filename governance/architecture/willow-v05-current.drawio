        <mxCell id="ledger" value="&lt;b&gt;FRANK ledger&lt;/b&gt; hash-chained record of acts&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ 1,206 entries (was 927 at v0.4)&lt;/font&gt;&lt;br&gt;&lt;b&gt;human_required queue&lt;/b&gt; — 15 open&lt;br&gt;&lt;b&gt;attestations&lt;/b&gt; — 75, of which &lt;font color=&quot;#2e7d32&quot;&gt;68 recovered&lt;/font&gt; from willow_20_test" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="770" y="240" width="380" height="120" as="geometry" /></mxCell>

        <mxCell id="gate" value="&lt;b&gt;Gate — PGP · store_scope · egress&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ pgp_enforced · 6 capability permissions, ALL grantable (#396)&lt;/font&gt;&lt;br&gt;task_net · task_db · integration_net · web_net · mcp_federation · grove_relay&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ Kart egress needs 3 keys: cap + consent.internet + operator lease&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ shut at 2 of 3 today — consent false, 0 leases&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ WILLOW_MCP_STRICT_TRUST_ROOT unset · earned rungs unset&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="700" height="130" as="geometry" /></mxCell>

        <mxCell id="hub" value="&lt;b&gt;willow-mcp — the hub&lt;/b&gt;  ~180 verbs&lt;br&gt;session · store · kb · dispatch · task (Kart) · handoff · commitment · lineage&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ federation lane OPEN (#396) — discover · list_servers · call&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ lanes.py merged (#397) — Lane.of_store · Crossing · I-12 response_lane&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ WILLOW_LANE undeclared · nothing calls refusal() yet&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ willow_web_search · web_fetch · institutional_search → retiring to Jeles&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="400" width="760" height="130" as="geometry" /></mxCell>

        <mxCell id="nestor" value="&lt;b&gt;Nestor — has a human checked this?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ own org home: Die-Namic-Systems/.nestor (moved 2026-08-28)&lt;/font&gt;&lt;br&gt;599 sealed pairs · 11,061 corpus claims · 24 repos&lt;br&gt;&lt;b&gt;tool oracle&lt;/b&gt; — 109 sealed · 3 rejected · 4 draft&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ reject now works without a session (#256)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ dogfood decisions: 223 draft, 0 sealed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="360" height="140" as="geometry" /></mxCell>

        <mxCell id="jeles" value="&lt;b&gt;Jeles — the verified-nugget corpus&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ FEDERATED MCP SERVER — jeles-corpus / 8cae3d1dcdf4&lt;/font&gt;&lt;br&gt;PGP-signed · ratified_by sean · env_keys=() · first and only&lt;br&gt;14 tools · corpus_web_search · institutional_search · verify_claim&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ models may only REDUCE what the system claims (#72)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ no corpus_fetch — willow_web_fetch has no successor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="430" y="580" width="400" height="140" as="geometry" /></mxCell>

        <mxCell id="kart" value="&lt;b&gt;Kart — execution&lt;/b&gt;  bwrap sandbox&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ fast lane live — willow-mcp-worker-fast.service&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ kart-worker + kart-worker-batch point at ~/SAFE/.venv&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;   — that path no longer exists; both inactive&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ NO bind for sean-data-vault (0 refs in kart-sandbox.json)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="860" y="580" width="400" height="140" as="geometry" /></mxCell>

        <mxCell id="grove" value="&lt;b&gt;Grove — the watchman's seat&lt;/b&gt;&lt;br&gt;loopback 127.0.0.1:8766 · MCP on :8765 (serve)&lt;br&gt;u2u LAN: KNOCK · NOTE · ASK · REPLY · ALERT · SHARE&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ per-kind consent, allow/deny/PENDING, 24h TTL&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ gate-denied to specialists — a seat cannot record its own work&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1290" y="580" width="400" height="140" as="geometry" /></mxCell>

