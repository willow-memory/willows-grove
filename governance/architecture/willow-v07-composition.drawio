<mxfile host="app.diagrams.net" modified="2026-08-29T06:40:00Z" agent="willow" version="24.0.0">
  <diagram id="willow-composition" name="Willow — how it composes, v0.7">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="legend" value="&lt;b&gt;Willow — HOW IT COMPOSES, v0.7 · 2026-08-29&lt;/b&gt;  &lt;font color=&quot;#888888&quot;&gt;b17: WGRV1  ΔΣ=42&lt;/font&gt;&lt;br&gt;v0.5 measured the plumbing. v0.6 argued about where repos live. This one is about &lt;b&gt;what attaches to what, and what is lost when a piece is used alone.&lt;/b&gt;&lt;br&gt;Every seat and every module attaches to the same two things — &lt;b&gt;willow-mcp&lt;/b&gt; for what it may do, &lt;b&gt;nestor&lt;/b&gt; for whether a human has checked it — and every attachment is &lt;b&gt;signed&lt;/b&gt;.&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;green = the spine&lt;/font&gt; · &lt;font color=&quot;#1565c0&quot;&gt;blue = a seat a human sits in&lt;/font&gt; · purple = signature &amp;amp; law · &lt;font color=&quot;#b97700&quot;&gt;amber = a module&lt;/font&gt; · &lt;font color=&quot;#c62828&quot;&gt;red = what is missing&lt;/font&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="90" as="geometry" /></mxCell>

        <mxCell id="human" value="&lt;b&gt;THE HUMAN&lt;/b&gt;&lt;br&gt;&lt;br&gt;holds &lt;b&gt;three things nothing else may hold&lt;/b&gt;:&lt;br&gt;· the vault key&lt;br&gt;· the net lease&lt;br&gt;· the signature that seals&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;may propose AND confirm&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;everything else may only propose&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="300" height="220" as="geometry" /></mxCell>

        <mxCell id="seats" value="&lt;b&gt;SEATS — where the human actually sits&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="500" height="20" as="geometry" /></mxCell>

        <mxCell id="grove" value="&lt;b&gt;Grove&lt;/b&gt; — the watchman's seat&lt;br&gt;loopback 127.0.0.1:8766 · portless by rule&lt;br&gt;live panes over Postgres · Nestor · kb_journal&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;three-state contract: populated / empty / UNREACHABLE&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;u2u to other nodes — Ed25519 signed&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ specialists are gate-denied — a seat cannot post its own work&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1565c0;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="380" y="170" width="460" height="130" as="geometry" /></mxCell>

        <mxCell id="rat" value="&lt;b&gt;Ratatosk&lt;/b&gt; — the sovereign seat&lt;br&gt;direct Anthropic API · full tool loop · JSONL sessions&lt;br&gt;MCP client · Grove-wired · personas · &lt;font color=&quot;#2e7d32&quot;&gt;--local → Ollama&lt;/font&gt;&lt;br&gt;&lt;i&gt;the squirrel that runs messages up and down the tree&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;u2u carries the handshake, never the bytes&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1565c0&quot;&gt;this is the seat that needs no cloud model&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1565c0;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="880" y="170" width="460" height="130" as="geometry" /></mxCell>

        <mxCell id="borrowed" value="&lt;b&gt;Borrowed seats&lt;/b&gt; — Claude Code · Cursor · claude.ai&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ same manifest, same app_id, same gate&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ someone else's client, someone else's model&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ their transcripts are invisible to the corpus&lt;/font&gt;&lt;br&gt;&lt;i&gt;useful, and the reason Ratatosk exists&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1380" y="170" width="420" height="130" as="geometry" /></mxCell>

        <mxCell id="sign" value="&lt;b&gt;THE SIGNATURE THREAD&lt;/b&gt;&lt;br&gt;runs through every arrow on this page&lt;br&gt;&lt;br&gt;&lt;b&gt;manifest&lt;/b&gt; — PGP detached sig; unsigned refuses the server fleet-wide&lt;br&gt;&lt;b&gt;seal&lt;/b&gt; — ed25519, browser-held private half&lt;br&gt;&lt;b&gt;u2u&lt;/b&gt; — ed25519 per packet; authenticate BEFORE authorise&lt;br&gt;&lt;b&gt;FRANK&lt;/b&gt; — hash chain, 1,206 links&lt;br&gt;&lt;b&gt;federation&lt;/b&gt; — server_id is a digest of launch identity, not a label&lt;br&gt;&lt;b&gt;crossing&lt;/b&gt; — guardian-signed, both lanes named, expiry required&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;&lt;i&gt;a name anyone can type into a field is not a ratification&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1840" y="140" width="500" height="220" as="geometry" /></mxCell>

        <mxCell id="spineband" value="&lt;b&gt;THE SPINE — two things, and everything attaches to both. Neither is behind the other.&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1100" height="20" as="geometry" /></mxCell>

        <mxCell id="hub" value="&lt;b&gt;willow-mcp — WHAT YOU MAY DO&lt;/b&gt;&lt;br&gt;&lt;br&gt;every caller arrives as an &lt;b&gt;app_id&lt;/b&gt; with a &lt;b&gt;PGP-signed manifest&lt;/b&gt;&lt;br&gt;· &lt;b&gt;permissions&lt;/b&gt; — tool groups + 6 capability flags, each on its own line&lt;br&gt;· &lt;b&gt;store_scope&lt;/b&gt; — you see your own collections and no others&lt;br&gt;· &lt;b&gt;deny_tools&lt;/b&gt; — subtractive, wins over any grant&lt;br&gt;· &lt;b&gt;egress&lt;/b&gt; — capability + consent + a live operator lease. Three keys.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;fails closed everywhere: no manifest = deny all&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;every downstream MCP is federated through here — signed, ratified&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ except two, deliberately: nestor and codebase-memory&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="740" height="210" as="geometry" /></mxCell>

        <mxCell id="nestor" value="&lt;b&gt;nestor — WHETHER A HUMAN HAS CHECKED IT&lt;/b&gt;&lt;br&gt;&lt;br&gt;every answer comes back in one of three states, never collapsed:&lt;br&gt;· &lt;b&gt;sealed&lt;/b&gt; — a named human signed it; serve verbatim, cite them&lt;br&gt;· &lt;b&gt;draft&lt;/b&gt; — a machine made it; never present as verified&lt;br&gt;· &lt;b&gt;pending&lt;/b&gt; — nothing verified matched; say so, do not improvise&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;cannot seal, unseal, or override — by construction, not by policy&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;a rejection can never be refused for want of a session (#256)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1565c0&quot;&gt;the tool oracle: intent → verb, only where a human sealed the mapping&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="430" width="740" height="210" as="geometry" /></mxCell>

        <mxCell id="why2" value="&lt;b&gt;why these two and not one&lt;/b&gt;&lt;br&gt;&lt;br&gt;willow-mcp answers &lt;i&gt;may I&lt;/i&gt;.&lt;br&gt;nestor answers &lt;i&gt;is it true&lt;/i&gt;.&lt;br&gt;&lt;br&gt;Folding them together would let&lt;br&gt;the thing that grants permission&lt;br&gt;also grant belief — which is the&lt;br&gt;whole failure the covenant exists&lt;br&gt;to prevent.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;so nestor is NOT behind the hub&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1600" y="430" width="330" height="210" as="geometry" /></mxCell>

        <mxCell id="kart" value="&lt;b&gt;Kart&lt;/b&gt; — the only place code runs&lt;br&gt;bwrap · network namespace · no credentials without allow_net&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;a task cannot reach the host, or the vault, or another lane&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1970" y="430" width="370" height="90" as="geometry" /></mxCell>

        <mxCell id="lanes" value="&lt;b&gt;Lanes&lt;/b&gt; — system · personal&lt;br&gt;the lane is the STORE, not a column&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;a crossing is guardian-signed, directional, expiring&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1970" y="550" width="370" height="90" as="geometry" /></mxCell>

        <mxCell id="modband" value="&lt;b&gt;MODULES — each installs and runs alone. The column on the right of each is what it LOSES alone.&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1300" height="20" as="geometry" /></mxCell>

        <mxCell id="m_hk" value="&lt;b&gt;hornbook-knowledge&lt;/b&gt; · Jeles · UTETY · oakenscrolls&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;ALONE: a verified-nugget corpus with its own MCP server,&lt;br&gt;its own rungs, its own refusals. Fully usable.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;LOSES: the human rung. verify_human_write needs nestor's&lt;br&gt;keyring — without it corpus_put can only ever mint 'asserted'.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="560" height="120" as="geometry" /></mxCell>

        <mxCell id="m_ha" value="&lt;b&gt;homestead-affairs&lt;/b&gt; · law · health · ledger&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;ALONE: the most standalone thing here. Embedded SQLite,&lt;br&gt;I-26 asserts no network module is even imported.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;LOSES: nothing operational — but no seal on its records,&lt;br&gt;so 'a human checked this' is unavailable to a household.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640" y="710" width="560" height="120" as="geometry" /></mxCell>

        <mxCell id="m_tp" value="&lt;b&gt;terpsi-programs&lt;/b&gt; · terpsi-music&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;ALONE: a records system with rungs, envelopes, and&lt;br&gt;forgery tests. Where the fleet's patterns were proved.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;LOSES: nothing. It is the donor, not the dependent —&lt;br&gt;rule 14 and Crossing were ported OUT of here.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1240" y="710" width="560" height="120" as="geometry" /></mxCell>

        <mxCell id="m_alm" value="&lt;b&gt;almanac-data&lt;/b&gt; · 12 almanacs + template&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;ALONE: public reference data, held not fetched.&lt;br&gt;Names nobody. Same for every household.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;LOSES: nothing — it is the one module with no secrets&lt;br&gt;and no seat.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1840" y="710" width="500" height="120" as="geometry" /></mxCell>

        <mxCell id="m_safe" value="&lt;b&gt;safe-app-store&lt;/b&gt; · 43 apps&lt;br&gt;&lt;font color=&quot;#1565c0&quot;&gt;ALONE: apps a person opens directly. law-gazelle, the-table,&lt;br&gt;story-timeline, marching-arts — none needs the fleet to be useful.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;LOSES: the signed manifest. An app outside the store is just&lt;br&gt;software; inside it, it declares what it may touch and is refused otherwise.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1565c0;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="560" height="120" as="geometry" /></mxCell>

        <mxCell id="m_fp" value="&lt;b&gt;forge-play&lt;/b&gt; · Forge&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;ALONE: a build loop with a calibration ledger — state a claim's&lt;br&gt;confidence, resolve it when truth arrives, route overconfidence to review.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;LOSES: nothing yet — the loop has never been called. ~/.forge&lt;br&gt;does not exist. Written, tested, wired to nothing.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640" y="850" width="560" height="120" as="geometry" /></mxCell>

        <mxCell id="m_ws" value="&lt;b&gt;workshop&lt;/b&gt; · codebase-memory · courtlistener · redential&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;ALONE: tools we did not write, used as themselves.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;codebase-memory is the SECOND deliberate exception — it talks&lt;br&gt;to a seat directly, like nestor, because indexing is not a governed act.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1240" y="850" width="560" height="120" as="geometry" /></mxCell>

        <mxCell id="m_wm" value="&lt;b&gt;willow-memory&lt;/b&gt; · the machinery&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;ALONE: a hub with nothing to hub. This is the&lt;br&gt;one module that is meaningless by itself.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;It is not a product. It is the socket the others plug into.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1840" y="850" width="500" height="120" as="geometry" /></mxCell>

        <mxCell id="comp" value="&lt;b&gt;WHAT THE FULL SUITE ADDS, WITH THE HUMAN IN THE GROVE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1 · A claim can be believed.&lt;/b&gt;  Alone, Jeles can say &quot;asserted&quot;. Composed, a human seals it in nestor and every seat that asks gets the same verbatim answer with the verifier's name on it. That is the only thing in this box that turns an assertion into knowledge, and it needs both halves: nestor to hold the seal, willow-mcp to carry it to the seat that asked.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 · A refusal is legible instead of silent.&lt;/b&gt;  Alone, a module that cannot do something simply does not. Composed, the gate names which permission was missing, the three-state contract distinguishes empty from unreachable, and a rejection is recorded with its reason rather than vanishing. &lt;i&gt;A recorded negative is not an absence.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3 · Work done in one seat is visible from another.&lt;/b&gt;  Grove reads what Ratatosk did. A gap logged in Jeles reaches willow-mcp's backlog. FRANK chains acts across all of them. Alone, each module's work dies in its own store.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 · The human stays the only ratifier — across everything at once.&lt;/b&gt;  One keyring, one signature, one seat. Not eleven separate consents. That is the whole reason the spine is two boxes and not eleven.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;&lt;b&gt;And what is NOT true yet:&lt;/b&gt; the Grove seat is gate-denied to specialists, so the seat that does the work cannot post it. Orientation is empty by construction for jeles. Three of four converging gaps point at the same fix — put the state in the payload a seat receives at entry, so a denial is legible before it costs work rather than after.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="2300" height="330" as="geometry" /></mxCell>

        <mxCell id="foot" value="&lt;i&gt;Read with v0.4 (the intent, 2026-07-20), v0.5 (measured), v0.6 (where repos should live). This one answers: if you installed only one of these, what would you actually have?&lt;/i&gt;" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1350" width="1800" height="20" as="geometry" /></mxCell>

        <mxCell id="c1" value="sits in" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="human" target="grove"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" value="or in" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="human" target="rat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" value="app_id + signed manifest" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="grove" target="hub"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c4" value="app_id + signed manifest" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="rat" target="hub"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c5" value="direct — not through the hub" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="rat" target="nestor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c6" value="direct" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="grove" target="nestor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c7" value="the seal the hub serves" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="nestor" target="hub"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c8" value="task_submit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="hub" target="kart"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c9" value="federated · ratified · signed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d79b00;fontSize=11;" edge="1" parent="1" source="m_hk" target="hub"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c10" value="signed manifest" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#1565c0;fontSize=11;" edge="1" parent="1" source="m_safe" target="hub"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c11" value="the only seal authority" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="human" target="nestor"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
