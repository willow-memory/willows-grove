<mxfile host="app.diagrams.net" modified="2026-08-30T00:00:00Z" agent="willow" version="24.0.0">
  <diagram id="toolchain-path" name="Toolchain path v0.8 (draft)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="Where does a repo get its Python?  — draft, v0.8" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="600" height="30" as="geometry" /></mxCell>

        <mxCell id="repo" value="a repo&#10;(44 of them)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="160" height="60" as="geometry" /></mxCell>

        <mxCell id="need" value="needs to run something&#10;test · lint · build" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="160" height="60" as="geometry" /></mxCell>

        <mxCell id="ask" value="is the forge&#10;wired on this box?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="200" height="90" as="geometry" /></mxCell>

        <mxCell id="own" value="its own .venv&#10;&#10;the fallback&#10;8 exist today&#10;25 repos have none" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="200" height="110" as="geometry" /></mxCell>

        <mxCell id="fleet" value="ONE shared toolchain&#10;&#10;$WILLOW_HOME/venvs/&#10;(exists — 1 venv in it)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="360" y="300" width="240" height="110" as="geometry" /></mxCell>

        <mxCell id="base" value="base layer&#10;pytest · ruff · build&#10;what every repo needs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="360" y="460" width="240" height="80" as="geometry" /></mxCell>

        <mxCell id="major" value="per-major layers&#10;&#10;python  (today)&#10;node    (host has it, sandbox cannot see it)&#10;apk     (gradle + SDK — neither installed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="360" y="570" width="300" height="110" as="geometry" /></mxCell>

        <mxCell id="bind" value="kart-sandbox.json&#10;binds it in&#10;&#10;TODAY: 68 binds,&#10;none mention forge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="740" y="300" width="220" height="120" as="geometry" /></mxCell>

        <mxCell id="kart" value="Kart sandbox&#10;&#10;a build is a shell command&#10;its stdout is the plan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="740" y="460" width="220" height="100" as="geometry" /></mxCell>

        <mxCell id="build" value="the build runs&#10;and sees the toolchain" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="740" y="600" width="220" height="70" as="geometry" /></mxCell>

        <mxCell id="apk" value="APK builder&#10;= a new major" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1"><mxGeometry x="1040" y="600" width="180" height="70" as="geometry" /></mxCell>

        <mxCell id="plan" value="plan.py has no&#10;notion of majors yet&#10;&#10;a 2nd major forces it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1"><mxGeometry x="1040" y="460" width="180" height="100" as="geometry" /></mxCell>

        <mxCell id="sep" value="the orgs stay separate.&#10;this changes nothing about that —&#10;a repo still installs alone on a stranger's box.&#10;it only changes where the toolchain comes from&#10;on a box where the forge IS wired." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="280" height="120" as="geometry" /></mxCell>

        <mxCell id="today" value="TODAY, measured&#10;&#10;· 8 venvs, 7 different paths&#10;· 25 repos declare deps, no venv&#10;· fleet venv exists, 1 thing uses it&#10;· Kart sees /usr only&#10;· ~/.forge symlink missing&#10;· forge-play/.forge is empty" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1040" y="90" width="280" height="170" as="geometry" /></mxCell>

        <mxCell id="rev" value="REVISIONS — append as this is molded.&#10;What settles here graduates to v0.7 (the big map).&#10;&#10;2026-08-30  first draft, from the venv conversation.&#10;            open question: nothing answers the diamond —&#10;            there is no flag a repo can consult to know&#10;            whether the forge is wired.&#10;&#10;2026-08-30  CORRECTION: the SDK and gradle ARE installed&#10;            (~/Android/Sdk, gradle 8.14.3, 2026-08-29 23:57).&#10;            Neither is on PATH and kart-sandbox.json names&#10;            them zero times, so the toolchain exists on the&#10;            host and not inside the sandbox.&#10;&#10;2026-08-30  Corpus intake now has its own map: v0.9." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1040" y="290" width="320" height="150" as="geometry" /></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="repo" target="need"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="need" target="ask"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ask" target="own"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ask" target="fleet"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="fleet" target="base"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="base" target="major"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="must be bound" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="fleet" target="bind"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="bind" target="kart"><mxGeometry relative="1" as="geometry" /></mxCell>
