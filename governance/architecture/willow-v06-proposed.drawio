<mxfile host="app.diagrams.net" modified="2026-08-29T06:10:00Z" agent="willow" version="24.0.0">
  <diagram id="willow-proposed" name="Willow — proposed, v0.6">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="legend" value="&lt;b&gt;Willow — PROPOSED, v0.6 · 2026-08-29&lt;/b&gt;  &lt;font color=&quot;#888888&quot;&gt;b17: WGRV1  ΔΣ=42&lt;/font&gt;&lt;br&gt;An opinion, not a measurement. 44 repos across 8 org folders as they stand, placed by what each org is &lt;i&gt;for&lt;/i&gt;.&lt;br&gt;v0.4 (2026-07-20) predates the org split entirely and shows one flat &quot;Dev Repos — ~/github (60 repos)&quot;. v0.5 measured the plumbing. This one argues about shape.&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;green = right place today&lt;/font&gt; · &lt;font color=&quot;#b97700&quot;&gt;amber = works, wrong home&lt;/font&gt; · &lt;font color=&quot;#c62828&quot;&gt;red = should move&lt;/font&gt; · purple = law · &lt;font color=&quot;#1565c0&quot;&gt;blue = product&lt;/font&gt; · grey = not ours" style="text;html=1;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="86" as="geometry" /></mxCell>

        <mxCell id="wsband" value="&lt;b&gt;THE WORKSPACE — outside ~/github, and mostly unversioned&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="700" height="20" as="geometry" /></mxCell>

        <mxCell id="ws_vault" value="&lt;b&gt;~/sean-data-vault&lt;/b&gt;  5.3 GB  &lt;font color=&quot;#2e7d32&quot;&gt;git, pull-only&lt;/font&gt;&lt;br&gt;THE destination. v0.4's (USER)-data-vault node.&lt;br&gt;today: snapshots · postgres dumps · archives&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;should also hold: the live box&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="330" height="100" as="geometry" /></mxCell>

        <mxCell id="ws_nest" value="&lt;b&gt;~/Desktop/Nest&lt;/b&gt;  4.1 GB  &lt;font color=&quot;#c62828&quot;&gt;no repo&lt;/font&gt;&lt;br&gt;the intake drop zone (FLEET_PLACEMENT §9)&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ 4 GB is not a drop zone, it is a silo&lt;/font&gt;&lt;br&gt;nest_intake_scan exists; nothing drains it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="330" height="100" as="geometry" /></mxCell>

        <mxCell id="ws_claude" value="&lt;b&gt;~/.claude&lt;/b&gt;  144 MB  &lt;font color=&quot;#c62828&quot;&gt;no repo&lt;/font&gt;&lt;br&gt;43 session transcripts · 20k words you typed&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ invisible to every instrument on this box&lt;/font&gt;&lt;br&gt;the vision lives here and nowhere else" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="760" y="150" width="330" height="100" as="geometry" /></mxCell>

        <mxCell id="ws_arch" value="&lt;b&gt;~/github-archive-* &lt;/b&gt; 4 trees  ·  &lt;b&gt;~/github/archive/&lt;/b&gt;&lt;br&gt;greenfield-2026-08-10 · willow-2026-08-27 · grove-2026-08-27&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ held design/architecture — 2.4 MB, recovered only 2026-08-29&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ retirement notes live in ~/github/archive, trees live outside it&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1120" y="150" width="420" height="100" as="geometry" /></mxCell>

        <mxCell id="ws_misc" value="&lt;b&gt;~/Documents&lt;/b&gt; 18 MB · &lt;b&gt;~/Ashokoa&lt;/b&gt; 76 KB&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ willow-v01.drawio was here, uncommitted&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ Ashokoa/agents/hanuman holds a handoffs.db&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1570" y="150" width="380" height="100" as="geometry" /></mxCell>

        <mxCell id="orgband" value="&lt;b&gt;THE ORGS — ~/github, 8 folders, 44 repos.  v0.4 knew none of this: it drew one box, &quot;Dev Repos (60 repos)&quot;.&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="1400" height="20" as="geometry" /></mxCell>

        <mxCell id="org_wm" value="&lt;b&gt;willow-memory&lt;/b&gt; — &lt;i&gt;the machinery&lt;/i&gt;  (8)&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;willow-mcp&lt;/font&gt; the hub · &lt;font color=&quot;#2e7d32&quot;&gt;willow-gate&lt;/font&gt; trust ladder&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;kartikeya&lt;/font&gt; sandbox · &lt;font color=&quot;#2e7d32&quot;&gt;willows-grove&lt;/font&gt; watchman + charter&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;corpus-lens&lt;/font&gt; · &lt;font color=&quot;#2e7d32&quot;&gt;willow-data-vault&lt;/font&gt; blueprint · dotgithub&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ .willow — the LIVE BOX, and it is a git repo:&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;   remote = rudi193-cmd/willow-config (a personal account)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="450" height="140" as="geometry" /></mxCell>

        <mxCell id="org_dns" value="&lt;b&gt;Die-Namic-Systems&lt;/b&gt; — &lt;i&gt;verification&lt;/i&gt;  (2)&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;nestor&lt;/font&gt; — has a human checked this?&lt;br&gt;dotgithub&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ .nestor now lives here too (2026-08-28)&lt;/font&gt;&lt;br&gt;&lt;i&gt;one repo, and it is the one the covenant runs on&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="320" width="380" height="140" as="geometry" /></mxCell>

        <mxCell id="org_hk" value="&lt;b&gt;hornbook-knowledge&lt;/b&gt; — &lt;i&gt;what is known&lt;/i&gt;  (4)&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;Jeles&lt;/font&gt; verified-nugget corpus, federated server&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;UTETY&lt;/font&gt; the faculty · &lt;font color=&quot;#2e7d32&quot;&gt;oakenscrolls-office&lt;/font&gt;&lt;br&gt;dotgithub&lt;br&gt;&lt;i&gt;knowledge and the personas that carry it&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="930" y="320" width="400" height="140" as="geometry" /></mxCell>

        <mxCell id="org_ha" value="&lt;b&gt;homestead-affairs&lt;/b&gt; — &lt;i&gt;the household&lt;/i&gt;  (6)&lt;br&gt;&lt;font color=&quot;#1565c0&quot;&gt;homestead&lt;/font&gt; · &lt;font color=&quot;#1565c0&quot;&gt;-law&lt;/font&gt; · &lt;font color=&quot;#1565c0&quot;&gt;-health&lt;/font&gt; · &lt;font color=&quot;#1565c0&quot;&gt;-ledger&lt;/font&gt;&lt;br&gt;awesome-sovereign-software · dotgithub&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ embedded SQLite · I-26 no network module imports&lt;/font&gt;&lt;br&gt;&lt;i&gt;the grandma side: no egress to grant, by construction&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1360" y="320" width="440" height="140" as="geometry" /></mxCell>

        <mxCell id="org_alm" value="&lt;b&gt;almanac-data&lt;/b&gt; — &lt;i&gt;public reference&lt;/i&gt;  (14)&lt;br&gt;agriculture · civic · climate · economy · education · energy&lt;br&gt;environment · health · justice · science · transportation&lt;br&gt;+ almanac-template · almanac-data · dotgithub&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ held-not-fetched (H-5) — public data, names nobody&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1830" y="320" width="470" height="140" as="geometry" /></mxCell>

        <mxCell id="org_ws" value="&lt;b&gt;workshop&lt;/b&gt; — &lt;i&gt;tools we did not write&lt;/i&gt;  (4)&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;codebase-memory-mcp&lt;/font&gt; — one of two MCPs NOT behind the hub&lt;br&gt;courtlistener-mcp · redential-cli · DispatchesFromReality&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ 48 of 51 cbm indexes point at trees that are gone&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="450" height="120" as="geometry" /></mxCell>

        <mxCell id="org_tp" value="&lt;b&gt;terpsi-programs&lt;/b&gt; — &lt;i&gt;where the patterns were proved&lt;/i&gt;  (2)&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;terpsi-music&lt;/font&gt; · dotgithub&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ rule 14 rungs · Envelope crossing, forgery-tested&lt;/font&gt;&lt;br&gt;&lt;i&gt;a music repo holds the fleet's lane-crossing type&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="490" width="380" height="120" as="geometry" /></mxCell>

        <mxCell id="org_fp" value="&lt;b&gt;forge-play&lt;/b&gt; — &lt;i&gt;the workshop face&lt;/i&gt;  (2)&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;Forge&lt;/font&gt; · dotgithub&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ calibration_ledger written, never called&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ ~/.forge does not exist — nothing recorded yet&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="930" y="490" width="400" height="120" as="geometry" /></mxCell>

        <mxCell id="org_safe" value="&lt;b&gt;safe-app-store-public&lt;/b&gt; — &lt;i&gt;the product layer&lt;/i&gt;  (43 apps, 1 repo)&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ sits at ~/github top level, not in an org&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;✗ remote = rudi193-cmd/safe-app-store — a personal account&lt;/font&gt;&lt;br&gt;ai-game-master · the-table · law-gazelle · story-timeline · the-forge&lt;br&gt;marching-arts · oakenscrolls-office · utety-chat · ask-jeles · +34&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ ask-jeles is a husk — the work became a federated server&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1565c0;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1360" y="490" width="940" height="120" as="geometry" /></mxCell>

        <mxCell id="propband" value="&lt;b&gt;WHAT I THINK SHOULD CHANGE — five moves, in dependency order&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="900" height="20" as="geometry" /></mxCell>

        <mxCell id="m1" value="&lt;b&gt;1 · The live box moves to the vault&lt;/b&gt;  &lt;font color=&quot;#c62828&quot;&gt;the v0.4 target, still ✗&lt;/font&gt;&lt;br&gt;&lt;br&gt;$WILLOW_HOME is ALREADY a git repo — &lt;b&gt;rudi193-cmd/willow-config&lt;/b&gt;.&lt;br&gt;So this is not &quot;put the box under version control&quot;. The box is already&lt;br&gt;versioned, into a personal-account repo that is not the data vault and&lt;br&gt;not in any org. That is the actual defect.&lt;br&gt;&lt;br&gt;&lt;b&gt;Move:&lt;/b&gt; $WILLOW_HOME → ~/sean-data-vault/.willow&lt;br&gt;Postgres → dumps in the vault, live cluster stays a system service&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;keys stay 0600 and gitignored — provision.sh already assumes this&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;⚠ the Kart bind MUST land first, or every task reads an empty store&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="560" height="230" as="geometry" /></mxCell>

        <mxCell id="m2" value="&lt;b&gt;2 · safe-app-store gets an org&lt;/b&gt;&lt;br&gt;&lt;br&gt;43 apps, the entire product layer, on a personal account at the&lt;br&gt;top level of ~/github. Every other face has an org.&lt;br&gt;&lt;br&gt;It is also the layer v0.4 got most wrong, and the layer a new&lt;br&gt;user actually touches. If the box is ever more than one person&lt;br&gt;this is the first thing that has to not be &lt;i&gt;yours&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ and cull: ask-jeles is a husk, the-forge is half-promoted&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1565c0;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="630" y="680" width="540" height="230" as="geometry" /></mxCell>

        <mxCell id="m3" value="&lt;b&gt;3 · The transcripts become visible&lt;/b&gt;&lt;br&gt;&lt;br&gt;~/.claude is 144 MB and NOTHING on this box can read it.&lt;br&gt;Not the corpus (extracts .py and .md from git checkouts),&lt;br&gt;not codebase-memory, not Nestor.&lt;br&gt;&lt;br&gt;43 sessions · 719 messages you typed · 20,141 words.&lt;br&gt;&lt;b&gt;The full vision appears in exactly 3 of them.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;The corpus holds 8,340 claims about what the code does&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c62828&quot;&gt;and 0 about why any of it exists.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1200" y="680" width="540" height="230" as="geometry" /></mxCell>

        <mxCell id="m4" value="&lt;b&gt;4 · The Nest gets drained&lt;/b&gt;&lt;br&gt;&lt;br&gt;4.1 GB on the Desktop, no repo, no index.&lt;br&gt;FLEET_PLACEMENT calls it a &quot;runtime drop zone&quot;.&lt;br&gt;&lt;br&gt;nest_intake_scan · nest_promote · nest_digest&lt;br&gt;all exist on the hub. Nothing runs them.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;A drop zone nothing drains is a silo with&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;better manners.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1770" y="680" width="530" height="230" as="geometry" /></mxCell>

        <mxCell id="m5" value="&lt;b&gt;5 · One archive, not five&lt;/b&gt;  ·  ~/github-archive-greenfield · -willow · -grove · ~/github/archive/&lt;br&gt;Four trees outside ~/github, retirement notes inside it, and 2.4 MB of architecture that nobody could find for a day because the directory was classified by its parent.&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;Proposal: archives land in the vault under archive-migration/&lt;date&gt;/ with a README naming what moved and what deliberately did not — the shape already used on 2026-08-28.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="2260" height="90" as="geometry" /></mxCell>

        <mxCell id="cmp" value="&lt;b&gt;COMPARED TO WHAT WAS PULLED FROM THE ARCHIVED willow REPO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;v0.1&lt;/b&gt; (~/Documents, never committed anywhere) · &lt;b&gt;v0.2&lt;/b&gt; · &lt;b&gt;v0.3-full&lt;/b&gt; · &lt;b&gt;v0.4-full&lt;/b&gt; 2026-07-20 — all predate the org split.&lt;br&gt;They draw &lt;i&gt;one&lt;/i&gt; box: &quot;Dev Repos — ~/github (60 repos): willow · willow-2.0 · willow-mcp · kartikeya · safe-app-store-publ…&quot;. Flat. No orgs.&lt;br&gt;&lt;br&gt;&lt;b&gt;What the stale versions still get right:&lt;/b&gt; the three-key egress gate · what the operator holds · lanes are mutually sealed ·&lt;br&gt;willow_web_* retiring to Jeles · and the (USER)-data-vault target, which they marked ✗ six weeks ago and is still ✗.&lt;br&gt;&lt;br&gt;&lt;b&gt;What they cannot see:&lt;/b&gt; eight orgs · 44 repos · Jeles as a federated server rather than a SAFE app · a personal lane ·&lt;br&gt;nestor with its own org and home · 43 apps where they show a handful · and that the live box is a git repo pointing at the wrong remote.&lt;br&gt;&lt;br&gt;&lt;i&gt;The diagrams were not wrong. They were unfinished, and then unreachable — left in an archive under a directory named for the repo it lived in,&lt;br&gt;when its contents were about everything except that repo.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="2260" height="240" as="geometry" /></mxCell>

        <mxCell id="a1" value="the box belongs here" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#c62828;fontColor=#c62828;fontSize=11;" edge="1" parent="1" source="org_wm" target="ws_vault"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" value="needs an org" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#1565c0;fontColor=#1565c0;fontSize=11;" edge="1" parent="1" source="org_safe" target="org_ha"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" value="patterns ported into willow-mcp" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="org_tp" target="org_wm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" value="federated in" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="org_hk" target="org_wm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" value="seals what the fleet believes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="org_dns" target="org_wm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a6" value="drain into the corpus" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontColor=#b97700;fontSize=11;" edge="1" parent="1" source="ws_nest" target="org_dns"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a7" value="the why lives here, unread" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#c62828;fontColor=#c62828;fontSize=11;" edge="1" parent="1" source="ws_claude" target="org_dns"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
