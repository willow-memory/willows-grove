# Example environment for Willow's Grove.
# Copy to .env and fill in local values.

# Postgres — the single DSN Grove uses. Overrides the legacy
# WILLOW_PG_DB + WILLOW_PG_USER pair.
# WILLOW_DB_URL=postgresql://postgres@localhost/willow_20

# Postgres timeouts. grove_db.py sets a connect_timeout (default 5s)
# and a session-level statement_timeout (default 30000 ms). Bump these
# for slow networks; a stuck-but-reachable Postgres surfaces the
# failure quickly instead of hanging on the OS default socket timeout.
# GROVE_PG_CONNECT_TIMEOUT=5
# GROVE_PG_STATEMENT_TIMEOUT_MS=30000

# grove_serve.py — served-page host binding. Non-numeric GROVE_SERVE_PORT
# refuses with sys.exit(2) and an operator-legible message.
# GROVE_SERVE_HOST=127.0.0.1
# GROVE_SERVE_PORT=8766

# WILLOW_HOME — per-node operator state (Nestor store, personas file,
# seed canon fallback path). Defaults to reasonable candidates in
# grove_serve.py.
# WILLOW_HOME=~/.willow

# Ollama — for the resident watcher's classify path.
# OLLAMA_HOST=http://127.0.0.1:11434

# Grove MCP serve mode. Loopback-only by default; a non-loopback URL
# without WILLOW_MCP_TUNNEL_ACKNOWLEDGED=1 logs a warning at startup.
# GROVE_MCP_URL=http://127.0.0.1:8765
# WILLOW_MCP_TUNNEL_ACKNOWLEDGED=1

# Serve-mode dynamic client registration — off by default.
# GROVE_MCP_ALLOW_DYNAMIC_REGISTRATION=1

# Trusted-proxy allowlist for the /grove-approve loopback POST check
# when Grove runs behind a same-box reverse proxy (Pangolin, nginx,
# cloudflared, tailscale). Comma-separated IPs. When set, if the raw
# TCP peer is in this set, X-Forwarded-For's rightmost IP becomes the
# effective peer for loopback checking. Default-closed.
# GROVE_MCP_TRUSTED_PROXIES=127.0.0.1
