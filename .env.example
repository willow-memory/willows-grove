# Willow Grove — environment configuration
# Copy this file to .env and adjust for your setup.
# None of these are required if your Postgres database is named willow_19
# and is accessible by your current OS user via peer/ident auth.

# ── Database connection ──────────────────────────────────────────────────────
# Option A: full DSN (takes precedence if set)
# WILLOW_DB_URL=postgresql://youruser:yourpass@localhost/willow_19

# Option B: individual settings
# WILLOW_PG_DB=willow_19
# WILLOW_PG_USER=youruser

# ── Willow system root ───────────────────────────────────────────────────────
# Path to your willow-1.9 checkout. Used by the Health and Skills panes.
# If unset, the dashboard looks for ~/github/willow-1.9.
# Those panes degrade gracefully if the path doesn't exist.
# WILLOW_ROOT=~/github/willow-1.9

# ── SOIL store ───────────────────────────────────────────────────────────────
# Local key-value store used for cursors and active model config.
# WILLOW_STORE_ROOT=~/.willow/store

# ── Known agents ─────────────────────────────────────────────────────────────
# Names of agents whose messages appear in the ThoughtStream widget.
# If unset, discovered automatically from HEARTBEAT messages in the DB.
# GROVE_KNOWN_AGENTS=hanuman,heimdallr,ganesha

# ── Dashboard Grove identity (chat + ⚡ ATTENTION mentions) ────────────────────
# Default sender when unset is Auto (matches public.agents Cursor router row).
# GROVE_SENDER=Auto
# GROVE_NAME=Auto
# ATTENTION aggregates @mentions for: dashboard sender + @all + comma extras:
# GROVE_DESK_MENTIONS=hanuman,loki
